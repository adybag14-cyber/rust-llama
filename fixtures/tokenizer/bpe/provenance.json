  "comparison_contract": {
    "expected_data_source": "Only original C++ Unicode functions, original C API calls and native standard-library operations produce expected results. Rust never produces expected fixture data.",
    "framing": "Exact SHA-256 of little-endian length-framed native token IDs, attributes, byte pieces and four detokenizations; vocabulary score bits and EOG included. Detailed schemas in README.md.",
    "platform_differences": "Native wide regex and ambiguous inferred special-ID map order have explicit separate Windows/Linux expectations. No broad tolerances or fallback tokenizers.",
    "special_order": "Original reserves n_tokens before insertion. MSVC uses FNV-1a64 and power-of-two buckets, groups in first-insertion order; libstdc++ uses MurmurHash64A and recorded prime buckets, groups in reverse first-insertion order. Collision groups iterate reverse insertion in both. Data and hashes independently captured.",
    "optional_inputs": "All 14 original BPE vocabularies are hash-pinned; only GPT-2 is copied into the repository. Other frozen source vocabularies are supplied through LLAMA_TEST_BPE_VOCAB_DIR for explicit tests.",
    "limits": "4 MiB public input; 1 million vocabulary entries; 4 million merge entries; frozen regex VM bounded by nesting 64, repetition 4096, program 65536 and explicit work budget. Exceeding a bound is an explicit error.",
    "remaining_families": "T5/UGM, RWKV and PLaMo are separate unimplemented tokenizer families. This corpus does not claim new model architectures or backends."
  },
